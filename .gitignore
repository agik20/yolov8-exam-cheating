# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Model weights (external storage — not committed) ─────────────────────────
# Place trained model files here manually:
#   inference/models/pose-70s.pt
#   inference/models/v8s-object.pt
# See inference/models/README.md for instructions.
inference/models/*.pt
inference/models/*.onnx
inference/models/*.engine
inference/models/*.bin
inference/models/*.safetensors
inference/models/*.weights

# ─── Video / media files (all kept locally) ───────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.webm
.jpg

# ─── Archives ──────────────────────────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.7z

# ─── Runtime logs (regenerated on every run) ──────────────────────────────────
detection_log*.txt
*_detection_log.csv

# ─── Sample input / annotation outputs (kept locally) ────────────────────────
inference/input/
inference-annotation/output/*
!inference-annotation/output/.gitkeep

# ─── Generated inference outputs (images, crops, room frames) ─────────────────
inference/output/**
!inference/output/benchmark_results.json
!inference/output/**/.gitkeep

# ─── Datasets (if present at repo root) ───────────────────────────────────────
datasets/
data/

# ─── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# ─── Environment secrets ───────────────────────────────────────────────────────
.env
*.env

# ─── Log files ─────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
